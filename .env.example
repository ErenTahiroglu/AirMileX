# ==============================================================================
# AirMileX — Environment Variables & Secrets Specification (.env.example)
# Phase 5C-0: Isolated Staging Provisioning & Provider E2E Verification
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real production API keys, service role keys, or secrets.
# - The active production project (lumfnuyzdyzpokcxykvn) MUST REMAIN ISOLATED.
# - All E2E provider testing must run against a DEDICATED Supabase staging project
#   and sandbox provider accounts (Paddle Sandbox, Staging Geoapify, Synthetic Airtable).
#
# ==============================================================================
# SECTION 1: Client-Side Environment Variables (Vite Frontend)
# ==============================================================================
# Injected into the browser bundle during build/dev (`import.meta.env`).
# Note: For staging preview, point these to your STAGING Supabase project.

# Staging Supabase Project Reference (e.g., "abcdefghijklmnopqrst")
VITE_SUPABASE_PROJECT_ID="your-staging-project-ref"

# Staging Supabase Project URL (e.g., "https://abcdefghijklmnopqrst.supabase.co")
VITE_SUPABASE_URL="https://your-staging-project-ref.supabase.co"

# Staging Supabase Anon / Publishable Key (Safe for browser client)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Feature Flag: Enable Paddle checkout modal on /pricing (set to "true" for staging E2E tests, default "false")
VITE_ENABLE_PADDLE_CHECKOUT="false"


# ==============================================================================
# SECTION 2: Supabase Staging Project & Database Settings
# ==============================================================================
# Used by CLI / migrations / integration test runner.
# Set these in your local terminal or CI environment, NOT in public client code.

# Direct PostgreSQL connection string for applying migrations to the staging project
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-STAGING-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-staging-db-password@db.your-staging-project-ref.supabase.co:5432/postgres"

# Staging Supabase Service Role Key (BYPASSES RLS - High Privilege - Edge Functions / DB Admin Only)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ==============================================================================
# SECTION 3: Supabase Edge Functions Secrets
# ==============================================================================
# Configure these on your STAGING project via Supabase CLI:
#   supabase secrets set --project-ref <your-staging-ref> KEY=VALUE ...
#
# Do NOT place these into the frontend .env bundle.

# --- Geoapify (Geocoding, Distance Matrix & Address Autocomplete) ---
# Operator-managed staging API key (Keep request volume minimal, strictly no fallback)
GEOAPIFY_API_KEY="your_staging_geoapify_api_key"

# --- Paddle Billing Sandbox Configuration ---
# Must be set to "sandbox" for staging testing
PADDLE_ENVIRONMENT="sandbox"

# Paddle Sandbox API Key (Created in Paddle Sandbox Dashboard -> Developer tools -> Authentication)
PADDLE_API_KEY="paddlesandbox_api_key_..."

# Paddle Sandbox Price ID for $9 / 500 Credits package (e.g. "pri_01...")
PADDLE_PRICE_ID="pri_sandbox_500_credits_price_id"

# Paddle Sandbox Webhook Signing Secret (Created in Paddle Sandbox Dashboard -> Notifications)
PADDLE_WEBHOOK_SECRET="pdl_ntfset_sandbox_secret_..."

# Edge Function Gate: Enable staging server-side checkout creation ("true" for E2E tests, "false" otherwise)
PADDLE_CHECKOUT_ENABLED="false"

# --- Lovable AI Gateway (Optional / AI helpers) ---
# API key for Lovable AI purpose generation / address cleanup
LOVABLE_API_KEY="your_lovable_api_key"


# ==============================================================================
# SECTION 4: External Provider E2E Test Fixtures & Synthetic Base Data
# ==============================================================================
# Used by test runners to validate external integrations with zero customer data.

# --- Supabase Auth E2E Test Credentials ---
# Controlled mailbox for testing 6-digit OTP email signup, credit grant & deletion
STAGING_TEST_USER_EMAIL="staging-test-user@yourdomain.com"
STAGING_TEST_USER_PASSWORD="StagingTestPassword123!"

# --- Airtable Integration Synthetic Test Base ---
# Dedicated Airtable Personal Access Token (PAT) with:
# scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TEST_PAT="pat_sandbox_test_token_..."

# ID of synthetic Airtable base created exclusively for testing (starts with "app...")
AIRTABLE_TEST_BASE_ID="appSyntheticTestBase123"

# Table ID or Name in the synthetic test base (e.g. "Trips" or "tbl...")
AIRTABLE_TEST_TABLE_ID="tblSyntheticTrips123"


# ==============================================================================
# SECTION 5: Test Runner & Local Preview Configurations
# ==============================================================================
# Base URL for Playwright browser E2E test runs (default: local Vite preview)
PLAYWRIGHT_BASE_URL="http://127.0.0.1:8080"
